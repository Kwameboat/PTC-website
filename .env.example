# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Database: Supabase Postgres connection string. Use the "Transaction pooler" URI
# (port 6543) from Supabase > Connect. Leave unset locally to use a built-in
# Postgres stored in ./.pgdata.
DATABASE_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres"

# One-time copy from the old Turso database: keep these set for the first deploy
# on Supabase, check /api/health shows "migrated_from_turso", then remove them.
TURSO_DATABASE_URL="libsql://your-db-name-your-org.turso.io"
TURSO_AUTH_TOKEN="your-turso-token"

# Admin login, used only when the database has no admin user yet.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="choose-a-strong-password"
# Signs admin login tokens. Any long random string.
ADMIN_SECRET="long-random-string"

# Optional CRM hand-off: contact-form inquiries and WhatsApp taps are POSTed here
# as JSON (Zapier / Make / n8n webhook, or a CRM's own webhook URL).
CRM_WEBHOOK_URL=""
# Optional: if set, each request carries an X-Signature-SHA256 HMAC of the body.
CRM_WEBHOOK_SECRET=""
